# Clave de la API de Anthropic (obligatoria)
ANTHROPIC_API_KEY=sk-ant-...

# Password compartido para acceder a la UI (recomendado en cualquier despliegue público).
# Si se deja vacío, NO se exige autenticación — solo apropiado para desarrollo local.
APP_PASSWORD=

# Opcional: sobrescribir los modelos por defecto
# GENERATION_MODEL=claude-opus-4-7
# UTILITY_MODEL=claude-haiku-4-5-20251001

# Opcional: rate limit por IP (peticiones por ventana de segundos).
# RATE_LIMIT_REQUESTS=5
# RATE_LIMIT_WINDOW_SECONDS=60

# Opcional: tamaño máximo del input de requisitos en caracteres.
# MAX_REQUIREMENTS_CHARS=10000

# Opcional: dónde se escriben los specs generados.
# Local: ./output  | Cloud Run: /tmp/output (única ruta con permiso de escritura en el runtime)
# OUTPUT_DIR=./output
